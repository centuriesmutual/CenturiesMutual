# Public site URL (Vercel production / custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3030

# ---------------------------------------------------------------------------
# Cross-subdomain routing (PRODUCTION ONLY — leave unset for local dev)
# ---------------------------------------------------------------------------
# The member Wallet and Admin portal each live on their own subdomain in prod.
# When set, post-login redirects send members to the Wallet subdomain and the
# admin links resolve to the admin subdomain.
NEXT_PUBLIC_WALLET_URL=https://wallet.centuriesmutual.com
NEXT_PUBLIC_ADMIN_URL=https://admin.centuriesmutual.com
NEXT_PUBLIC_CAREERS_URL=https://careers.centuriesmutual.com
# Share the Supabase auth session across *.centuriesmutual.com so a login on the
# main site is recognized on wallet./admin. MUST start with a leading dot.
# Do NOT set on localhost (a domain-scoped cookie won't be stored there).
NEXT_PUBLIC_COOKIE_DOMAIN=.centuriesmutual.com

# ---------------------------------------------------------------------------
# Supabase (Vercel: Production / Preview / Development)
# Server secrets — never commit real values
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe mirrors (same URL + anon key; required for client auth helpers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Ledger Bridge — the ONLY backend for wallet/rewards (never call Fabric)
# ---------------------------------------------------------------------------
# Public base URL. Member (browser) calls send the Supabase JWT as a Bearer
# token to this host, so it must be exposed via NEXT_PUBLIC_*.
LEDGER_BRIDGE_URL=https://bridge.centuriesmutual.com
NEXT_PUBLIC_LEDGER_BRIDGE_URL=https://bridge.centuriesmutual.com

# Server-only admin key (rewards:admin scope) used by
# /api/admin/activate-wallet and the admin Hyperledger logs view. NEVER expose
# to the browser — no NEXT_PUBLIC_.
LEDGER_BRIDGE_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Admin portal (/admin) — server-only allowlist
# ---------------------------------------------------------------------------
# Comma-separated list of emails allowed into the admin portal (and editor staff
# when set). Fails closed: if empty, no one can access /admin data. These accounts
# sign in with their normal Supabase email/password. Never prefix with NEXT_PUBLIC_.
ADMIN_EMAILS=

# Site login: email/password via Supabase Auth (/login, /create-account)
# Coinbase / Robinhood OAuth remain Wallet Cash Out linking only.

# Coinbase OAuth — Wallet Cash Out linking
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Robinhood OAuth — Wallet Cash Out linking (partner API when available)
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_AUTH_URL=
ROBINHOOD_TOKEN_URL=
ROBINHOOD_TRANSFER_URL=
ROBINHOOD_SCOPES=account:read transfers:write

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_DEFAULT_QUERY=Centuries Mutual
