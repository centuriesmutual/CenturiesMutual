# Public site URL (Vercel production URL or custom domain)
# Used for Coinbase / Robinhood OAuth redirect URIs
NEXT_PUBLIC_APP_URL=http://localhost:3030

# Site login is email/password via /login and /create-account (Wallet session).
# Auth0 env vars are optional and not required for deploy or member login.

# Coinbase OAuth — Wallet Cash Out linking only
# https://www.coinbase.com/oauth/applications
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Robinhood OAuth — Wallet Cash Out linking only (partner / brokerage API)
ROBINHOOD_CLIENT_ID=
ROBINHOOD_CLIENT_SECRET=
ROBINHOOD_AUTH_URL=
ROBINHOOD_TOKEN_URL=
ROBINHOOD_TRANSFER_URL=
ROBINHOOD_SCOPES=account:read transfers:write

# YouTube Data API v3 (optional on Vercel)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_DEFAULT_QUERY=Centuries Mutual
