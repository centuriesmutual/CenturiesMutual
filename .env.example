# Centuries Mutual Labs — environment template
# Copy to .env and fill values. Never commit real secrets.

# API
CENTURIES_MUTUAL_LABS_API_HOST=127.0.0.1
CENTURIES_MUTUAL_LABS_API_PORT=8080
CENTURIES_MUTUAL_LABS_LOG_LEVEL=INFO

# Data paths (relative to repo root unless absolute)
CENTURIES_MUTUAL_LABS_DATA_RAW=data/raw
CENTURIES_MUTUAL_LABS_DATA_PROCESSED=data/processed
CENTURIES_MUTUAL_LABS_DATA_REFERENCE=data/reference

# Optional external data providers (leave blank if unused)
# FRED_API_KEY=
# POLYGON_API_KEY=
