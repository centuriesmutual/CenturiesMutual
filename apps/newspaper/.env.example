# Newspaper CMS — environment (newspaper.centuriesmutual.com)
# Copy to .env.local for local dev; set the real values in the Vercel project.
# NEVER commit real secrets.

# Auth0
AUTH0_SECRET=
AUTH0_BASE_URL=https://newspaper.centuriesmutual.com
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Box.com App Auth (JWT) — content storage
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_PUBLIC_KEY_ID=
BOX_PRIVATE_KEY=
BOX_PASSPHRASE=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=
